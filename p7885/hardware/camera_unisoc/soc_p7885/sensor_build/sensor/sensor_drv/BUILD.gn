import("//build/ohos.gni")

OEM_DIR = "oem2v6"
ISPALG_DIR = "ispalg"
ISPDRV_DIR = "pss/isp2.7"
PART_NAME="soc_p7885"
SUBSYSTEM_NAME="soc_p7885"

ohos_shared_library("sensor_imx616") {


  cflags = [ "-w", "-g", "-O", "-fPIC", "-Wno-unused-variable" ] 

  include_dirs = [
    "./classic/Sony/imx616",
    "./../inc",
    "./../../kiface/interface/",
    "./../../modules/interface",
    "./../../$OEM_DIR/inc",
    "./../../$ISPDRV_DIR/driver/inc",
    "./../../$ISPDRV_DIR/middleware/inc",
    "./../../$ISPDRV_DIR/isp_tune",
    "./../../common/inc",
    "./../../$ISPALG_DIR/common/inc",
    "./../../$ISPALG_DIR/ae/sprd/ae/inc",
    "./../../libcaminiparser",
  ]

  sources = [
    "./classic/Sony/imx616/sensor_imx616_mipi_raw.c",
  ]

  external_deps = [
    "hilog:libhilog"
  ]
  
  deps = [
    "//device/soc/unisoc/p7885/hardware/camera_unisoc/soc_p7885/camera_hal:camerahal2",
    "//device/soc/unisoc/p7885/hardware/camera_unisoc/soc_p7885/camera_hal:camerahal11",
    "//third_party/libxml2:libxml2",
    "//device/soc/unisoc/p7885/hardware/camera_unisoc/soc_p7885/camera_hal:camerahal3",
  ]
  install_images = [ chipset_base_dir ]
  part_name = "${PART_NAME}"
  subsystem_name = "${SUBSYSTEM_NAME}"
  install_enable = true
}


