# avc:  denied  { ioctl } for  pid=15081 comm="collectEvents" path="/dev/input/event0" dev="tmpfs" ino=333 ioctlcmd=0x4534 scontext=u:r:dinput:s0 tcontext=u:object_r:dev_input_file:s0 tclass=chr_file permissive=0
allow dinput dev_input_file:chr_file { ioctl };
allowxperm dinput dev_input_file:chr_file ioctl { 0x4534 };
