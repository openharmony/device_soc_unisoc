import("//build/ohos.gni")
import("//device/soc/unisoc/p7885/soc_common.gni")
uboot_image_dir = "//device/soc/unisoc/p7885/pac/ImageFiles"

group("pac") {
  deps = [
    ":encrypt_uboot_image",
  ]
}

# GPG-decrypt uboot.tar.gz.gpg -> .bin firmware files into output dir
action("encrypt_uboot_image") {
  script = "encrypt.sh"
  inputs = [ "$uboot_image_dir/uboot.tar.gz.gpg" ]
  outputs = [
    "$target_out_dir/fdl1-sign.bin",
    "$target_out_dir/lk-fdl2-sign.bin",
    "$target_out_dir/lk-sign.bin",
    "$target_out_dir/sml-sign.bin",
    "$target_out_dir/teecfg-sign.bin",
    "$target_out_dir/tos-sign.bin",
    "$target_out_dir/u-boot-spl-16k-emmc-sign.bin",
    "$target_out_dir/u-boot-spl-16k-ufs-sign.bin",
    "$target_out_dir/$target_name.stamp",
  ]
  args = [
    rebase_path("$uboot_image_dir/uboot.tar.gz.gpg"),
    rebase_path("$target_out_dir"),
    rebase_path("$target_out_dir/$target_name.stamp", root_build_dir),
  ]
}
